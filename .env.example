# ==============================================================================
# SoftBarber - Variáveis de Ambiente e Configuração de Produção/Contêineres
# ==============================================================================

# --- Banco de Dados MariaDB 11.4 LTS ---
MARIADB_HOST=db
MARIADB_PORT=3306
MARIADB_DATABASE=softbarber
MARIADB_USER=softbarber
MARIADB_PASSWORD=softbarber_secret
MARIADB_ROOT_PASSWORD=softbarber_root_secret

# Conexão SQLAlchemy com MariaDB
DATABASE_URL=mysql+pymysql://softbarber:softbarber_secret@db:3306/softbarber

# --- Segurança e Autenticação JWT ---
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_ADMIN_PIN=1234

# --- Portas de Exposição no Host ---
APP_PORT=80
BACKEND_PORT=8000

# --- Inicialização e Carga de Dados ---
AUTO_SEED=true
